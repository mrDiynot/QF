<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    QualiFlow - NuGet Configuration
    
    This file configures NuGet package sources and settings for the entire solution.
    
    Documentation: https://learn.microsoft.com/en-us/nuget/reference/nuget-config-file
  -->

  <packageSources>
    <!-- Official NuGet.org feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    
    <!-- GitHub Packages (if needed for private packages) -->
    <!-- <add key="github" value="https://nuget.pkg.github.com/QualiFlow-ai/index.json" /> -->
    
    <!-- Azure Artifacts (if needed for private packages) -->
    <!-- <add key="azure-artifacts" value="https://pkgs.dev.azure.com/qualiflow/_packaging/qualiflow/nuget/v3/index.json" /> -->
  </packageSources>

  <packageSourceCredentials>
    <!-- GitHub Packages authentication (if enabled) -->
    <!-- <github>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github> -->
  </packageSourceCredentials>

  <config>
    <!-- Global packages folder (default: ~/.nuget/packages) -->
    <add key="globalPackagesFolder" value="packages" />
    
    <!-- Dependency behavior -->
    <add key="dependencyVersion" value="Highest" />
    
    <!-- Package restore settings -->
    <add key="repositoryPath" value="packages" />
    
    <!-- Signature validation -->
    <add key="signatureValidationMode" value="require" />
  </config>

  <packageRestore>
    <!-- Enable automatic package restore -->
    <add key="enabled" value="True" />
    
    <!-- Automatically check for missing packages during build -->
    <add key="automatic" value="True" />
  </packageRestore>

  <bindingRedirects>
    <!-- Automatically generate binding redirects -->
    <add key="skip" value="False" />
  </bindingRedirects>

  <packageManagement>
    <!-- Use PackageReference format (not packages.config) -->
    <add key="format" value="1" />
    
    <!-- Disable package source mapping (use all sources) -->
    <add key="disabled" value="False" />
  </packageManagement>

  <disabledPackageSources>
    <!-- Disable specific package sources if needed -->
    <!-- <add key="github" value="true" /> -->
  </disabledPackageSources>

  <trustedSigners>
    <!-- Trust Microsoft packages -->
    <author name="microsoft">
      <certificate fingerprint="3F9001EA83C560D712C24CF213C3D312CB3BFF51EE89435D3430BD06B5D0EECE" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
    
    <!-- Trust NuGet.org packages -->
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>

</configuration>

