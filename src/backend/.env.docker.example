# ============================================================================
# QualiFlow Docker Environment Variables
# ============================================================================
# Copy this to .env.docker and fill in your values
# Usage: docker run --env-file .env.docker -p 5000:8080 qualiflow-api:dev
#
# TIP: Use the export script to convert your .NET User Secrets:
#      ./scripts/export-secrets-to-docker-env.sh > .env.docker
# ============================================================================

# =============================================================================
# REQUIRED - App will not start without these
# =============================================================================

# Database (Neon.tech PostgreSQL - same as local development)
# For Docker on Mac, use your Neon.tech connection string directly
ConnectionStrings__DefaultConnection=Host=ep-xxx.eastus2.azure.neon.tech;Port=5432;Database=qualiflow;Username=neondb_owner;Password=xxx;SSL Mode=Require

# JWT Authentication (generate with: openssl rand -base64 32)
Jwt__Secret=your-32-char-minimum-secret-key-here
Jwt__Issuer=http://localhost:5000
Jwt__Audience=http://localhost:3000

# =============================================================================
# ADMIN SEED - Required for first SuperAdmin user
# =============================================================================
AdminSeed__Email=superadmin@qualiflow.ai
AdminSeed__FirstName=Super
AdminSeed__LastName=Admin
AdminSeed__Password=SecurePassword123!

# =============================================================================
# OPTIONAL - Features will be disabled if not set
# =============================================================================

# OpenAI (AI features)
OpenAI__ApiKey=sk-proj-xxx

# Twilio (SMS/Voice/WhatsApp)
Twilio__Live__AccountSid=ACxxx
Twilio__Live__AuthToken=xxx
Twilio__Test__AccountSid=ACxxx
Twilio__Test__AuthToken=xxx
Twilio__Encryption__Key=xxx
Twilio__UseTestMode=true

# Stripe (Payments)
Stripe__SecretKey=sk_test_xxx
Stripe__PublishableKey=pk_test_xxx
Stripe__WebhookSecret=whsec_xxx

# Google OAuth
Authentication__Google__ClientId=xxx.apps.googleusercontent.com
Authentication__Google__ClientSecret=GOCSPX-xxx

# Microsoft OAuth
Authentication__Microsoft__ClientId=xxx
Authentication__Microsoft__ClientSecret=xxx

# Sentry (Error tracking)
Sentry__Dsn=https://xxx@xxx.ingest.sentry.io/xxx

# Resend (Email)
Resend__ApiKey=re_xxx
Email__FromAddress=no-reply@qualiflow.ai

# Frontend URL for CORS
FrontendUrl=http://localhost:3000

# CORS Allowed Origins
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=https://localhost:3000

# =============================================================================
# ENVIRONMENT
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
